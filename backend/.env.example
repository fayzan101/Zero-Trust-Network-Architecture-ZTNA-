# Copy to backend/.env — NEVER commit .env to git
#
# After a leak: rotate Neon password + JWT_SECRET in Neon/console, then update this file.

SPRING_DATASOURCE_URL=jdbc:postgresql://HOST/DBNAME?sslmode=require
SPRING_DATASOURCE_USERNAME=your_neon_user
SPRING_DATASOURCE_PASSWORD=your_neon_password

# Use a long random string (e.g. openssl rand -base64 48)
JWT_SECRET=
